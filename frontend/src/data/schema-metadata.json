    "userStatistics": {
      "triggers": ["berapa user", "jumlah pengguna", "total user", "statistik user"],
      "table": "profiles",
      "aggregations": ["COUNT(*)", "COUNT(*) GROUP BY role", "COUNT(*) GROUP BY status"],
      "responseTemplate": "Ada {total} pengguna: {breakdown_by_role}"
    },
    "tableStatistics": {
      "triggers": ["berapa {table}", "jumlah {table}", "statistik {table}"],
      "aggregations": ["COUNT(*)", "COUNT(*) GROUP BY status"],
      "responseTemplate": "Tabel {table}: {total} record total"
    }
  }
}
