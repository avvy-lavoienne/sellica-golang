# Staging Environment Configuration
# SELLY AI - Staging Deployment
# Date: 2025-01-27

# Environment
NODE_ENV=production
DEPLOYMENT_ENV=staging
STAGING=true
PORT=3000
HOSTNAME=0.0.0.0

# Supabase Configuration (Staging)
NEXT_PUBLIC_SUPABASE_URL=https://staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=staging_anon_key_here
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=staging_service_role_key_here

# SELLY Chatbot Configuration
DEEPSEEK_API_KEY=sk-staging-api-key-here

# Performance Monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
STAGING_METRICS_ENDPOINT=https://metrics.staging.sellica.com
PERFORMANCE_SAMPLE_RATE=1.0
ENABLE_DEBUG_LOGGING=true

# TensorFlow & AI Configuration
NEXT_PUBLIC_ENABLE_TENSORFLOW=true
NEXT_PUBLIC_TENSORFLOW_JS_MODEL_URL=/models/staging/basic-nlp/model.json
NEXT_PUBLIC_TENSORFLOW_SERVING_URL=http://localhost:8501
NEXT_PUBLIC_INDOBERT_MODEL_PATH=/models/staging/indobert-base

# TensorFlow Performance Configuration
TENSORFLOW_SERVING_TIMEOUT=10000
TENSORFLOW_SERVING_RETRY_ATTEMPTS=2
TENSORFLOW_CACHE_SIZE=1000
TENSORFLOW_PRELOAD_MODELS=true
TENSORFLOW_ENABLE_GRACEFUL_DEGRADATION=true
TENSORFLOW_FALLBACK_TIMEOUT=5000

# TensorFlow Development Configuration
TENSORFLOW_DEV_MODE=false
TENSORFLOW_MOCK_SERVING=false
TENSORFLOW_DEBUG_LOGGING=true

# Staging-specific Settings
STAGING_MODEL_PATH=/var/www/sellica/models
BUILD_VERSION=2.0
BUILD_ID=staging-build-$(date +%Y%m%d-%H%M%S)
DEPLOYMENT_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Load Testing Configuration
ENABLE_LOAD_TESTING=true
MAX_CONCURRENT_USERS=100
LOAD_TEST_DURATION=300

# Monitoring & Alerting
STAGING_ALERT_WEBHOOK=https://hooks.slack.com/services/staging/webhook
HEALTH_CHECK_INTERVAL=30000
METRICS_RETENTION_DAYS=7

# Redis Configuration (Optional)
# REDIS_URL=redis://localhost:6379

# Database Configuration
DB_CONNECTION_POOL_SIZE=10
DB_QUERY_TIMEOUT=30000
ENABLE_QUERY_LOGGING=true
SLOW_QUERY_THRESHOLD=1000

# Security Configuration
ENABLE_CORS=true
CORS_ORIGINS=https://staging.sellica.com,http://localhost:3000
ENABLE_CSP=true
ENABLE_HSTS=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=1000

# API Configuration
ENABLE_SWAGGER=true
ENABLE_API_DOCUMENTATION=true
ENABLE_REQUEST_LOGGING=true
ENABLE_RESPONSE_COMPRESSION=true
MAX_REQUEST_SIZE=10MB
API_TIMEOUT=30000

# Static Assets Configuration
ENABLE_CDN=false
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_MAX_AGE=3600
ENABLE_IMAGE_OPTIMIZATION=true
IMAGE_QUALITY=85

# Feature Flags
ENABLE_EXPERIMENTAL_FEATURES=true
ENABLE_BETA_FEATURES=true
ENABLE_DEBUG_MODE=true
ENABLE_PERFORMANCE_PROFILING=true
ENABLE_A11Y_TESTING=true

# Logging Configuration
LOG_LEVEL=debug
ENABLE_PERFORMANCE_LOGS=true
ENABLE_AI_LOGS=true
ENABLE_DATABASE_LOGS=true
ENABLE_NETWORK_LOGS=true
ENABLE_STRUCTURED_LOGGING=true
INCLUDE_STACK_TRACE=true
LOG_MAX_FILES=10
LOG_MAX_SIZE=100MB

# Next.js Specific
NEXT_TELEMETRY_DISABLED=1
ANALYZE=false

# PM2 Configuration
PM2_INSTANCES=2
PM2_EXEC_MODE=cluster
PM2_MAX_MEMORY_RESTART=1G
PM2_MAX_RESTARTS=10
PM2_MIN_UPTIME=10s

# Nginx Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_KEEPALIVE_TIMEOUT=65
NGINX_CLIENT_MAX_BODY_SIZE=10M

# SSL Configuration
SSL_CERT_PATH=/etc/letsencrypt/live/staging.sellica.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/staging.sellica.com/privkey.pem

# Backup Configuration
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 2 * * *
BACKUP_LOCATION=/var/backups/sellica

# Monitoring URLs
HEALTH_CHECK_URL=https://staging.sellica.com/api/health
METRICS_URL=https://staging.sellica.com/api/metrics
UPTIME_MONITOR_URL=https://uptime.staging.sellica.com
