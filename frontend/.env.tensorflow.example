# TensorFlow Integration Configuration untuk SELLY
# Copy file ini ke .env.local dan sesuaikan nilai-nilainya

# Enable/Disable TensorFlow Integration
NEXT_PUBLIC_ENABLE_TENSORFLOW=true

# Hugging Face Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
NEXT_PUBLIC_ENABLE_HUGGINGFACE=true
HUGGINGFACE_TIMEOUT=30000
HUGGINGFACE_RETRY_ATTEMPTS=2

# TensorFlow Serving Configuration
NEXT_PUBLIC_TENSORFLOW_SERVING_URL=http://localhost:8501
TENSORFLOW_SERVING_TIMEOUT=10000
TENSORFLOW_SERVING_RETRY_ATTEMPTS=2

# TensorFlow.js Model Configuration (Client-side models in /public/models/)
TENSORFLOW_MODEL_PATH=/public/models
TENSORFLOW_JS_MODEL_URL=/public/models/indonesian-nlp-v1.json
TENSORFLOW_JS_TOKENIZER_URL=/public/models/indonesian-nlp-v1_tokenizer.json

# IndoBERT Model Configuration
INDOBERT_MODEL_NAME=indobert
INDOBERT_MODEL_VERSION=1
INDOBERT_MAX_SEQUENCE_LENGTH=512

# Performance Configuration
TENSORFLOW_CACHE_SIZE=1000
TENSORFLOW_PRELOAD_MODELS=true
TENSORFLOW_ENABLE_GPU=false

# Monitoring and Logging
TENSORFLOW_ENABLE_PERFORMANCE_MONITORING=true
TENSORFLOW_LOG_LEVEL=info
TENSORFLOW_METRICS_RETENTION_DAYS=7

# Fallback Configuration
TENSORFLOW_FALLBACK_TIMEOUT=5000
TENSORFLOW_ENABLE_GRACEFUL_DEGRADATION=true

# Development Configuration
TENSORFLOW_DEV_MODE=false
TENSORFLOW_MOCK_SERVING=false
TENSORFLOW_DEBUG_LOGGING=false
