# Enhanced SELLY Configuration
# Copy this file to .env.local and configure your settings

# Enhanced SELLY Mode Configuration
SELLY_ENHANCED_MODE=false                    # Enable enhanced mode by default (true/false)
SELLY_GLOBAL_ENHANCEMENT_MODE=adaptive      # Global mode: standard/enhanced/adaptive
SELLY_DEFAULT_PERFORMANCE_MODE=balanced     # Performance: fast/balanced/comprehensive

# Feature Toggles
SELLY_ENABLE_CONTEXT_INTELLIGENCE=true      # Enable context intelligence
SELLY_ENABLE_DYNAMIC_RESPONSES=true         # Enable dynamic response generation
SELLY_ENABLE_PERSONA_ADAPTATION=true        # Enable persona adaptation
SELLY_ENABLE_KNOWLEDGE_SYNTHESIS=false      # Enable knowledge synthesis (for complex queries)
SELLY_ENABLE_LOCAL_AI=true                  # Enable local AI enhancements
SELLY_ENABLE_RESPONSE_VARIATIONS=false      # Enable response variations
SELLY_ENABLE_USER_LEARNING=true             # Enable user learning
SELLY_ENABLE_CULTURAL_ADAPTATION=true       # Enable cultural adaptation

# Performance Settings
SELLY_MAX_PROCESSING_TIME=300               # Maximum processing time in ms
SELLY_CACHE_ENABLED=true                    # Enable response caching
SELLY_PRELOAD_MODELS=false                  # Preload AI models on startup
SELLY_ENABLE_FALLBACKS=true                 # Enable fallback systems

# AI Enhancement Settings
SELLY_SENTIMENT_ANALYSIS_ENABLED=true       # Enable sentiment analysis
SELLY_INTENT_REFINEMENT_ENABLED=true        # Enable intent refinement
SELLY_QUALITY_ASSESSMENT_ENABLED=false      # Enable quality assessment
SELLY_RESPONSE_ENHANCEMENT_ENABLED=true     # Enable response enhancement
SELLY_CONFIDENCE_THRESHOLD=0.7              # AI confidence threshold

# Cultural and Language Settings
SELLY_PRIMARY_LANGUAGE=indonesian           # Primary language
SELLY_ENABLE_REGIONAL_DIALECTS=true         # Enable regional dialect support
SELLY_FORMALITY_LEVEL=auto                  # Formality: auto/formal/casual
SELLY_ADDRESS_PREFERENCE=auto               # Address: auto/kak/kakak/bapak_ibu

# User Experience Settings
SELLY_DEFAULT_RESPONSE_STYLE=adaptive       # Response style: formal/casual/adaptive
SELLY_ENABLE_EMOTICONS=true                 # Enable emoticon usage
SELLY_MAX_RESPONSE_LENGTH=1000              # Maximum response length
SELLY_ENABLE_INTERACTIVE_ASSESSMENTS=true   # Enable interactive assessments

# Development and Debugging
SELLY_DEBUG_MODE=false                      # Enable debug logging
SELLY_LOG_ENHANCEMENT_METRICS=true          # Log enhancement performance metrics
SELLY_ENABLE_PERFORMANCE_MONITORING=true    # Enable performance monitoring

# Database Configuration (if using external storage for user preferences)
# DATABASE_URL=postgresql://...             # Optional: Database for user preferences
# REDIS_URL=redis://...                     # Optional: Redis for caching

# External API Keys (optional, for future integrations)
# GEMINI_API_KEY=your_gemini_key           # Optional: Google Gemini API key
# OPENAI_API_KEY=your_openai_key           # Optional: OpenAI API key

# Supabase Configuration (existing)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Application Configuration (existing)
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:4000
