# Production Environment Configuration
# Copy this file to .env.production and configure your production settings

# Node Environment
NODE_ENV=production

# Enhanced SELLY Mode Configuration
SELLY_ENHANCED_MODE=true                     # Enable enhanced mode in production
SELLY_GLOBAL_ENHANCEMENT_MODE=adaptive      # Global mode: standard/enhanced/adaptive
SELLY_DEFAULT_PERFORMANCE_MODE=fast         # Performance: fast/balanced/comprehensive

# Feature Toggles (Production Optimized)
SELLY_ENABLE_CONTEXT_INTELLIGENCE=true      # Enable context intelligence
SELLY_ENABLE_DYNAMIC_RESPONSES=true         # Enable dynamic response generation
SELLY_ENABLE_PERSONA_ADAPTATION=true        # Enable persona adaptation
SELLY_ENABLE_KNOWLEDGE_SYNTHESIS=false      # Disable for performance
SELLY_ENABLE_LOCAL_AI=false                 # Disable local AI in production
SELLY_ENABLE_RESPONSE_VARIATIONS=false      # Disable for consistency
SELLY_ENABLE_USER_LEARNING=true             # Enable user learning
SELLY_ENABLE_CULTURAL_ADAPTATION=true       # Enable cultural adaptation

# Performance Settings (Production Optimized)
SELLY_MAX_PROCESSING_TIME=200               # Faster processing time in production
SELLY_CACHE_ENABLED=true                    # Enable response caching
SELLY_PRELOAD_MODELS=false                  # Don't preload models to save memory
SELLY_ENABLE_FALLBACKS=true                 # Enable fallback systems

# AI Enhancement Settings (Production Optimized)
SELLY_SENTIMENT_ANALYSIS_ENABLED=false      # Disable for performance
SELLY_INTENT_REFINEMENT_ENABLED=true        # Keep for accuracy
SELLY_QUALITY_ASSESSMENT_ENABLED=false      # Disable for performance
SELLY_RESPONSE_ENHANCEMENT_ENABLED=false    # Disable for performance
SELLY_CONFIDENCE_THRESHOLD=0.8              # Higher threshold for production

# Cultural and Language Settings
SELLY_PRIMARY_LANGUAGE=indonesian           # Primary language
SELLY_ENABLE_REGIONAL_DIALECTS=true         # Enable regional dialect support
SELLY_FORMALITY_LEVEL=auto                  # Formality: auto/formal/casual
SELLY_ADDRESS_PREFERENCE=auto               # Address: auto/kak/kakak/bapak_ibu

# User Experience Settings
SELLY_DEFAULT_RESPONSE_STYLE=adaptive       # Response style: formal/casual/adaptive
SELLY_ENABLE_EMOTICONS=true                 # Enable emoticon usage
SELLY_MAX_RESPONSE_LENGTH=800               # Shorter responses for production
SELLY_ENABLE_INTERACTIVE_ASSESSMENTS=true   # Enable interactive assessments

# Production Logging Configuration
SELLY_DEBUG_MODE=false                      # Disable debug logging in production
SELLY_LOG_ENHANCEMENT_METRICS=false         # Disable detailed metrics logging
SELLY_ENABLE_PERFORMANCE_MONITORING=true    # Keep performance monitoring

# Centralized Logging Configuration
LOG_LEVEL=WARN                              # Only warnings and errors in production
LOG_ENABLED_COMPONENTS=                     # Empty = only essential components
# Disable ALL verbose AI/ML logging in production
LOG_DISABLED_COMPONENTS=INDOBERT,TENSORFLOW,TRAINING_COLLECTOR,ANALYTICS,TEMPORAL_ANALYSIS,PERFORMANCE_MONITOR,CUSTOM_TRAINER,PREDICTIVE,PERSONALIZATION_AI,REAL_TIME_ANALYZER,CONTINUOUS_LEARNING,ADVANCED_NLP,RESPONSE_FORMATTER,ENHANCED_QUERY,HUGGINGFACE_SERVICE,AKTA_TRAINING,AKTA_KEMATIAN_TRAINING,AKTA_PENGAKUAN_ANAK_TRAINING,AKTA_PERKAWINAN_TRAINING,KIA_TRAINING,KK_TRAINING,DATA_QUALITY,MONITORING_INIT,USER_ANALYTICS,CHATBOT_INTEGRATION,ENHANCED_TOGGLE,SELLY_TOGGLE,SIMPLE_TOGGLE,UNIFIED_CHAT,MOCK,REALTIME_CHARTS,TEST,DEBUG,RESULT,ERROR,FINAL_TEST,TOOL_SELECTOR,MULTI_TABLE_SEARCH,MOCK_DB

# Client-Side Logging Control (Production - Minimal)
NEXT_PUBLIC_ENABLE_CLIENT_LOGGING=false     # Disable client-side console logging in production
NEXT_PUBLIC_LOG_LEVEL=error                 # Only log errors on client-side

# Database Configuration
DATABASE_URL=                               # Your production database URL

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=                   # Your Supabase URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=              # Your Supabase anon key
SUPABASE_SERVICE_ROLE_KEY=                  # Your Supabase service role key

# Cache Configuration (Production)
UPSTASH_REDIS_REST_URL=                     # Your Upstash Redis URL
UPSTASH_REDIS_REST_TOKEN=                   # Your Upstash Redis token

# AI/ML Configuration (Disabled in Production)
NEXT_PUBLIC_ENABLE_TENSORFLOW=false         # Disable TensorFlow in production
NEXT_PUBLIC_ENABLE_INDOBERT_SERVICE=false   # Disable IndoBERT in production
NEXT_PUBLIC_TENSORFLOW_JS_MODEL_URL=        # Empty - not used in production
NEXT_PUBLIC_TENSORFLOW_SERVING_URL=         # Empty - not used in production

# Security Settings
NEXTAUTH_SECRET=                            # Your NextAuth secret
NEXTAUTH_URL=                               # Your production URL

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true          # Enable performance monitoring
PERFORMANCE_LOG_LEVEL=warn                  # Only log warnings and errors

# Error Reporting
SENTRY_DSN=                                 # Your Sentry DSN for error reporting
ENABLE_ERROR_REPORTING=true                 # Enable error reporting

# Rate Limiting
ENABLE_RATE_LIMITING=true                   # Enable rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60          # Requests per minute per IP

# Health Checks
ENABLE_HEALTH_CHECKS=true                   # Enable health check endpoints
HEALTH_CHECK_INTERVAL=30000                 # Health check interval in ms
