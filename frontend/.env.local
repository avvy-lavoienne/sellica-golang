# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
# Go Backend API URL (for duplicate operator and other backend endpoints)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Enable Go Backend Authentication (Phase 2 implementation)
# Enabled - Go backend auth with context provider for dashboard
NEXT_PUBLIC_USE_GO_AUTH=true

# Enable fallback to Supabase if Go backend fails
NEXT_PUBLIC_ENABLE_AUTH_FALLBACK=true

# Go Backend URL for authentication
NEXT_PUBLIC_GO_BACKEND_URL=http://localhost:8080

# =============================================================================
# SELLY AI CONFIGURATION (Optional - can leave as defaults)
# =============================================================================
SELLY_ENHANCED_MODE=false
SELLY_GLOBAL_ENHANCEMENT_MODE=adaptive
SELLY_DEFAULT_PERFORMANCE_MODE=balanced
SELLY_ENABLE_CONTEXT_INTELLIGENCE=true
SELLY_ENABLE_DYNAMIC_RESPONSES=true
SELLY_ENABLE_PERSONA_ADAPTATION=true
SELLY_ENABLE_KNOWLEDGE_SYNTHESIS=false
SELLY_ENABLE_LOCAL_AI=true
SELLY_ENABLE_RESPONSE_VARIATIONS=false
SELLY_ENABLE_USER_LEARNING=true
SELLY_ENABLE_CULTURAL_ADAPTATION=true
SELLY_MAX_PROCESSING_TIME=300
SELLY_CACHE_ENABLED=true
SELLY_PRELOAD_MODELS=false
SELLY_ENABLE_FALLBACKS=true
SELLY_SENTIMENT_ANALYSIS_ENABLED=true
SELLY_INTENT_REFINEMENT_ENABLED=true
SELLY_QUALITY_ASSESSMENT_ENABLED=false
SELLY_RESPONSE_ENHANCEMENT_ENABLED=true
SELLY_CONFIDENCE_THRESHOLD=0.7

