{
  "name": "sellica",
  "version": "2.0",
  "private": true,
  "scripts": {
    "dev:frontend": "next dev",
    "dev:backend": "cd ../backend && go run ./cmd/server/main.go",
    "dev": "pm2 start ecosystem.config.js --env development",
    "dev:stop": "pm2 stop sellica-development",
    "dev:logs": "pm2 logs sellica-development",
    "dev:delete": "pm2 delete sellica-development",
    "prod": "pnpm build && pnpm start:prod",
    "start:prod": "concurrently \"pnpm start\" \"cd ../backend && go run ./cmd/server/main.go\"",
    "build": "cross-env DISABLE_RUNTIME_LOGS=true next build",
    "build:quiet": "cross-env DISABLE_RUNTIME_LOGS=true NEXT_PHASE=phase-production-build next build",
    "build:verbose": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "test": "jest",
    "clean": "rm -rf .next .turbo node_modules/.cache",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migration:silpana-ticketing": "npx tsx src/scripts/run-ticketing-migration.ts",
    "migration:silpana-ticketing:rollback": "npx tsx src/scripts/run-ticketing-migration.ts --rollback",
    "validate:performance": "tsx src/scripts/simple-performance-validation.ts",
    "test:enhanced": "jest --config=jest.config.enhanced.js",
    "test:enhanced:watch": "jest --config=jest.config.enhanced.js --watch",
    "test:enhanced:coverage": "jest --config=jest.config.enhanced.js --coverage",
    "test:unit": "jest --config=jest.config.enhanced.js --selectProjects=\"Unit Tests\"",
    "test:integration": "jest --config=jest.config.enhanced.js --selectProjects=\"Integration Tests\"",
    "test:e2e": "jest --config=jest.config.enhanced.js --selectProjects=\"E2E Tests\"",
    "test:performance:enhanced": "jest --config=jest.config.enhanced.js --selectProjects=\"Performance Tests\"",
    "type-check": "tsc --noEmit",
    "apply:rls-fixes": "pnpm exec tsx scripts/apply-rls-fixes.ts",
    "test:rls-policies": "pnpm exec tsx scripts/test-rls-policies.ts",
    "fix:critical-stability": "pnpm run apply:rls-fixes && pnpm run test:rls-policies",
    "safety:init": "tsx src/scripts/initializeSafetyInfrastructure.ts",
    "safety:validate": "tsx src/scripts/initializeSafetyInfrastructure.ts",
    "load-test:artillery": "artillery run artillery-config.yml",
    "load-test:artillery:report": "artillery run artillery-config.yml --output load-test-results.json && artillery report load-test-results.json"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "scripts": [
      "server.js"
    ],
    "targets": [
      "node16-win-x64"
    ],
    "outputPath": "dist"
  },
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@huggingface/inference": "^4.5.3",
    "@jest/globals": "^30.0.5",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/x-charts": "^8.9.0",
    "@mui/x-date-pickers": "^8.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.52.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@upstash/redis": "^1.35.3",
    "apexcharts": "^5.3.1",
    "autoprefixer": "^10.4.21",
    "axios": "^1.11.0",
    "browser-image-compression": "^2.0.2",
    "canvas": "^3.1.2",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "compressorjs": "^1.2.1",
    "critters": "^0.0.25",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "flowbite": "^3.1.2",
    "flowbite-datepicker": "^1.3.2",
    "flowbite-react": "^0.12.9",
    "framer-motion": "^12.23.9",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "jest-canvas-mock": "^2.5.2",
    "jest-webgl-canvas-mock": "^2.5.3",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.552.0",
    "next": "^15.4.4",
    "next-intl": "^4.4.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.8.16",
    "papaparse": "^5.5.3",
