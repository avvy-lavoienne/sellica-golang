    "cross-env": "^10.0.0",
    "dotenv": "^17.2.1",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.4.4",
    "ignore-loader": "^0.1.2",
    "inquirer": "^10.2.2",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jest-extended": "^6.0.0",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^3.0.1",
    "ora": "^8.2.0",
    "pm2": "^6.0.13",
    "tailwindcss": "3.4.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  }
}