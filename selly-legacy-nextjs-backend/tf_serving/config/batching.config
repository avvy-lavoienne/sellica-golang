# TensorFlow Serving Batching Configuration for SELLY AI Models
# Optimizes inference performance by batching requests

# Maximum batch size for Indonesian language models
max_batch_size { value: 8 }

# Batch timeout in microseconds (1000 microseconds = 1ms)
# Balance between latency and throughput
batch_timeout_micros { value: 5000 }  # 5ms timeout

# Maximum number of enqueued batches
max_enqueued_batches { value: 100 }

# Number of batch threads
num_batch_threads { value: 4 }

# Allowed batch sizes (powers of 2 for optimal GPU utilization)
allowed_batch_sizes { value: 1 }
allowed_batch_sizes { value: 2 }
allowed_batch_sizes { value: 4 }
allowed_batch_sizes { value: 8 }

# Pad variable-length inputs to the maximum length in the batch
pad_variable_length_inputs { value: true }
