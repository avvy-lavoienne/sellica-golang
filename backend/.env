# SELLY Go Backend Test Configuration
PORT=8080
GIN_MODE=debug
ENVIRONMENT=development
LOG_LEVEL=info

# Supabase Configuration (optional for testing)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis Configuration (optional for testing)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache settings
CACHE_TTL_SECONDS=300
CACHE_MEMORY_MAX_MB=100

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_HEALTH_CHECKS=true
